# .env.example — Plantilla del .env raíz (HITO-018 / notificaciones SMTP).
# Copiar a `.env` (ignorado por git) y completar QUARKUS_MAILER_PASSWORD.
# Fuente de la configuración: docs_implementacion/_sdd/04_implementacion.md §73.
QUARKUS_MAILER_HOST=smtp.office365.com
QUARKUS_MAILER_PORT=587
QUARKUS_MAILER_START_TLS=REQUIRED
QUARKUS_MAILER_USERNAME=admin.powerapps@vanguardfresh.pe
QUARKUS_MAILER_FROM=admin.powerapps@vanguardfresh.pe
# Completar con la contraseña real de la cuenta (NUNCA commitear).
QUARKUS_MAILER_PASSWORD=
# Contraseña de PostgreSQL local/producción; completar fuera de Git.
POSTGRES_PASSWORD=