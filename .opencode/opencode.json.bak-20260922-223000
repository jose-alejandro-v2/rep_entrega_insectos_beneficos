{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "subagent_depth": 2,
  "provider": {
    "opencode": {
      "whitelist": [
        "big-pickle",
        "deepseek-v4-flash-free",
        "hy3-free",
        "laguna-s-2.1-free",
        "ling-3.0-flash-fin-free",
        "mimo-v2.5-free",
        "muse-spark-1.2-contributor-free",
        "nemotron-3-ultra-free",
        "nemotron-3.5-lightning-free"
      ]
    }
  },
  "permission": {
    "skill": {
      "archify": "allow"
    }
  },
  "agent": {
    "orchestrator": {
      "mode": "primary",
      "permission": {
        "task": {
          "*": "deny",
          "developer": "allow",
          "auditor": "allow"
        }
      }
    },
    "developer": {
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": "deny"
      }
    },
    "auditor": {
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "ask",
        "task": "deny"
      }
    }
  }
}
